@page "/analyzer"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Text
@using EmailAnalyzer.Application
@using EmailAnalyzer.Domain
@using Markdig
@using Microsoft.AspNetCore.Authorization
@inject IEmailParser EmailParser
@inject IGeminiService GeminiService
@inject IJSRuntime JSRuntime
@inject AnalysisCounterService CounterService

<PageTitle>Analizator AI — EBARTNET Security</PageTitle>

<div class="analyzer-wrapper">

    <div class="analyzer-header">
        <h2 class="analyzer-title">Terminal Analityczny</h2>
        <p class="analyzer-subtitle">Wgraj plik .eml — AI przeanalizuje nagłówki pod kątem bezpieczeństwa</p>
    </div>

    <div class="glass-card analyzer-card">

        <!-- ── Obszar czatu ── -->
        <div class="chat-messages" id="terminal-output">

            @if (messages.Count == 0 && !IsLoading)
            {
                <div class="chat-empty">
                    <div class="chat-empty-icon">
                        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            <path d="m9 12 2 2 4-4"/>
                        </svg>
                    </div>
                    <div class="chat-empty-title">Gotowy do analizy</div>
                    <div class="chat-empty-sub">Wybierz plik .eml poniżej i kliknij Analizuj</div>
                </div>
            }

            @foreach (var msg in messages)
            {
                @if (msg.Role == "user")
                {
                    <div class="chat-row chat-row-user">
                        <div class="chat-user-bubble">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0">
                                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                            </svg>
                            @msg.Content
                        </div>
                    </div>
                }
                else if (msg.Role == "assistant")
                {
                    <div class="chat-row chat-row-assistant">
                        <div class="chat-avatar">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                        </div>
                        <div class="chat-assistant-bubble">@ConvertMarkdownToHtml(msg.Content)</div>
                    </div>
                }
                else if (msg.Role == "error")
                {
                    <div class="chat-row chat-row-assistant">
                        <div class="chat-avatar chat-avatar-error">!</div>
                        <div class="chat-error-bubble">@msg.Content</div>
                    </div>
                }
            }

            @if (IsLoading)
            {
                <div class="chat-row chat-row-assistant">
                    <div class="chat-avatar chat-avatar-pulse">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                    </div>
                    <div class="chat-loading-bubble">
                        <div class="chat-typing"><span></span><span></span><span></span></div>
                        @if (!string.IsNullOrEmpty(loadingPhase))
                        {
                            <div class="chat-loading-phase">@loadingPhase</div>
                        }
                    </div>
                </div>
            }

        </div>

        <!-- ── Pasek kontrolny — JEDEN RZĄD ── -->
        <div class="chat-input-bar">

            <select class="ctrl-select" @bind="selectedTemplateName" disabled="@IsLoading">
                @foreach (var t in GeminiService.DefaultTemplates)
                {
                    <option value="@t.Name">@t.Name</option>
                }
            </select>

            <label class="file-pick @(IsLoading ? "disabled" : "")">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0">
                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                </svg>
                <span class="file-label-text">@(string.IsNullOrEmpty(loadedFileName) ? "Wybierz .eml" : loadedFileName)</span>
                <InputFile OnChange="HandleFileSelected" disabled="@IsLoading" accept=".eml" style="display:none;" />
            </label>

            <!-- Spacer przesuwa przyciski akcji na prawą stronę -->
            <div class="input-spacer"></div>

            @if (analysisCompleted)
            {
                <button class="ctrl-btn ctrl-btn-ghost" @onclick="CopyReportToClipboard" title="Kopiuj raport">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    <span class="btn-label">Kopiuj raport</span>
                </button>
            }

            <button class="ctrl-btn ctrl-btn-secondary" @onclick="ClearConsole" disabled="@IsLoading" title="Wyczyść">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                <span class="btn-label">Wyczyść</span>
            </button>

            <button class="ctrl-btn ctrl-btn-primary" @onclick="Analyze" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span class="spin-icon">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                    </span>
                    <span>Analizuję...</span>
                }
                else
                {
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2L15 22l-4-9-9-4 20-7z"/></svg>
                    <span>Analizuj</span>
                }
            </button>

        </div>
    </div>
</div>

@code {
    private static readonly MarkdownPipeline MarkdownPipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    private record ChatMsg(string Role, string Content);
    private List<ChatMsg> messages = new();

    private string selectedTemplateName = string.Empty;
    private bool IsLoading = false;
    private bool analysisCompleted = false;
    private AnalysisResult? analysisResult;
    private byte[] fileContent = Array.Empty<byte>();
    private string loadedFileName = string.Empty;
    private string loadingPhase = string.Empty;

    private static readonly string[] LoadingPhases =
    {
        "Parsowanie nagłówków...",
        "Wysyłanie zapytania do AI...",
        "Analizowanie nagłówków...",
        "Generowanie raportu..."
    };

    private MarkupString ConvertMarkdownToHtml(string md)
    {
        if (string.IsNullOrWhiteSpace(md)) return new MarkupString("");
        return new MarkupString(Markdown.ToHtml(md, MarkdownPipeline));
    }

    protected override void OnInitialized()
        => selectedTemplateName = GeminiService.DefaultTemplates.First().Name;

    private async Task ScrollToBottom()
        => await JSRuntime.InvokeVoidAsync("scrollToBottom");

    private async Task CopyReportToClipboard()
    {
        if (analysisResult is not null)
            await JSRuntime.InvokeVoidAsync("copyToClipboard", analysisResult.AiAnalysis);
    }

    private async Task ClearConsole()
    {
        messages.Clear();
        fileContent = Array.Empty<byte>();
        loadedFileName = string.Empty;
        analysisCompleted = false;
        analysisResult = null;
        StateHasChanged();
    }

    private async Task Analyze()
    {
        if (fileContent.Length == 0)
        {
            messages.Add(new ChatMsg("error", "Wybierz plik .eml przed analizą."));
            StateHasChanged();
            return;
        }

        messages.Add(new ChatMsg("user", loadedFileName));
        IsLoading = true;
        analysisCompleted = false;
        analysisResult = null;
        loadingPhase = LoadingPhases[0];
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            EmailRecord? emailRecord = null;
            string? aiAnalysis = null;

            var task = Task.Run(async () =>
            {
                using var stream = new MemoryStream(fileContent);
                emailRecord = EmailParser.Parse(stream);
                var template = GeminiService.DefaultTemplates.First(t => t.Name == selectedTemplateName);
                aiAnalysis = await GeminiService.AnalyzeHeaders(emailRecord.RawHeaders, template);
            });

            int phaseIdx = 0;
            while (!task.IsCompleted)
            {
                phaseIdx = (phaseIdx + 1) % LoadingPhases.Length;
                loadingPhase = LoadingPhases[phaseIdx];
                StateHasChanged();
                await ScrollToBottom();
                await Task.Delay(1200);
            }

            await task;

            analysisResult = new AnalysisResult
            {
                FileName = loadedFileName,
                AnalysisDate = DateTime.Now,
                From = emailRecord!.From,
                Subject = emailRecord.Subject,
                AiAnalysis = aiAnalysis!
            };

            messages.Add(new ChatMsg("assistant", aiAnalysis!));
            analysisCompleted = true;
            CounterService.Increment();
        }
        catch (Exception ex)
        {
            messages.Add(new ChatMsg("error", $"Błąd: {ex.Message}"));
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 10 * 1024 * 1024)
        {
            messages.Add(new ChatMsg("error", "Plik za duży (max 10 MB)."));
            StateHasChanged();
            return;
        }
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
        fileContent = ms.ToArray();
        loadedFileName = file.Name;
        StateHasChanged();
    }
}

<style>
    /* ── Wrapper — pełna szerokość ── */
    .analyzer-wrapper {
        width: 100%;
        padding: 1.25rem 1.25rem 1.5rem;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .analyzer-header { text-align: center; }

    .analyzer-title {
        font-family: 'Inter', sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: .04em;
        margin: 0 0 .3rem;
        color: var(--color-title);
    }

    .analyzer-subtitle {
        font-family: 'Inter', sans-serif;
        color: var(--color-subtitle);
        font-size: .82rem;
        margin: 0;
    }

    /* ── Card ── */
    .analyzer-card {
        padding: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    /* ── Chat messages ── */
    .chat-messages {
        min-height: 380px;
        max-height: 60vh;
        overflow-y: auto;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* Empty state */
    .chat-empty {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .6rem;
        padding: 2.5rem 1rem;
    }

    .chat-empty-icon { color: var(--color-empty-icon); filter: drop-shadow(0 0 10px rgba(124,58,237,.2)); }
    .chat-empty-title { font-family: 'Inter', sans-serif; font-size: .9rem; color: var(--color-empty-title); font-weight: 500; }
    .chat-empty-sub   { font-family: 'Inter', sans-serif; font-size: .78rem; color: var(--color-empty-sub); }

    /* ── Rows ── */
    .chat-row { display: flex; gap: .65rem; align-items: flex-start; }
    .chat-row-user { justify-content: flex-end; }

    /* ── User bubble ── */
    .chat-user-bubble {
        background: linear-gradient(135deg, rgba(124,58,237,.35), rgba(88,28,135,.45));
        border: 1px solid rgba(192,132,252,.35);
        border-radius: 16px 16px 4px 16px;
        padding: .65rem 1rem;
        max-width: 60%;
        font-family: 'Inter', sans-serif;
        font-size: .85rem;
        color: #e2e8f0;
        display: flex;
        align-items: center;
        gap: .45rem;
        word-break: break-all;
    }

    /* ── AI Avatar ── */
    .chat-avatar {
        width: 30px; height: 30px; min-width: 30px;
        background: linear-gradient(135deg, #7c3aed, #0891b2);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: #fff;
        box-shadow: 0 0 10px rgba(124,58,237,.4);
        margin-top: 2px;
    }

    .chat-avatar-pulse { animation: avatar-pulse 1.8s ease-in-out infinite; }

    @@keyframes avatar-pulse {
        0%, 100% { box-shadow: 0 0 10px rgba(124,58,237,.4); }
        50%       { box-shadow: 0 0 22px rgba(124,58,237,.75), 0 0 40px rgba(6,182,212,.3); }
    }

    .chat-avatar-error {
        background: linear-gradient(135deg, #dc2626, #9f1239);
        font-family: 'Inter', sans-serif; font-weight: 700;
    }

    /* ── Assistant bubble ── */
    .chat-assistant-bubble {
        background: var(--color-chat-ai-bg);
        border: 1px solid var(--color-chat-ai-border);
        border-radius: 4px 16px 16px 16px;
        padding: .9rem 1.1rem;
        flex: 1; min-width: 0;
        font-family: 'Inter', sans-serif;
        font-size: .85rem;
        color: var(--color-chat-ai-text);
        line-height: 1.7;
    }

    .chat-assistant-bubble p { margin: .25rem 0; }
    .chat-assistant-bubble ul, .chat-assistant-bubble ol { padding-left: 1.2rem; margin: .3rem 0; }
    .chat-assistant-bubble li { margin: .15rem 0; color: var(--text-muted); }

    .chat-assistant-bubble h1, .chat-assistant-bubble h2, .chat-assistant-bubble h3 {
        font-family: 'Inter', sans-serif; font-weight: 600;
        color: var(--primary-light);
        border-bottom: 1px solid var(--border);
        padding-bottom: .25rem; margin: .9rem 0 .4rem;
    }

    .chat-assistant-bubble table {
        width: 100%; border-collapse: collapse;
        margin: .65rem 0; font-size: .8rem;
    }

    .chat-assistant-bubble th, .chat-assistant-bubble td {
        border: 1px solid var(--border);
        padding: 5px 9px; text-align: left;
        color: var(--text-muted);
    }

    .chat-assistant-bubble th {
        background: rgba(124,58,237,.12);
        color: #a5b4fc; font-weight: 600;
    }

    .chat-assistant-bubble strong { color: #67e8f9; }
    .chat-assistant-bubble code {
        background: rgba(124,58,237,.18);
        padding: 1px 5px; border-radius: 3px;
        font-family: var(--font-mono); font-size: .83em;
        color: #c4b5fd;
    }

    /* Light mode — tabele i tekst w bąbelku AI */
    :global(html.light-mode) .chat-assistant-bubble th { background: rgba(124,58,237,.08); color: #6d28d9; }
    :global(html.light-mode) .chat-assistant-bubble strong { color: #0891b2; }
    :global(html.light-mode) .chat-assistant-bubble code { background: rgba(124,58,237,.1); color: #7c3aed; }
    :global(html.light-mode) .chat-assistant-bubble h1,
    :global(html.light-mode) .chat-assistant-bubble h2,
    :global(html.light-mode) .chat-assistant-bubble h3 { color: #7c3aed; }

    /* ── Loading bubble ── */
    .chat-loading-bubble {
        background: var(--color-chat-ai-bg);
        border: 1px solid var(--color-chat-ai-border);
        border-radius: 4px 16px 16px 16px;
        padding: .8rem 1.1rem;
        display: flex; flex-direction: column; gap: .4rem;
    }

    .chat-typing { display: flex; gap: 5px; align-items: center; height: 20px; }
    .chat-typing span {
        width: 7px; height: 7px;
        border-radius: 50%;
        display: inline-block;
        animation: typing-dot 1.4s ease-in-out infinite;
    }
    .chat-typing span:nth-child(1) { background: #7c3aed; }
    .chat-typing span:nth-child(2) { background: #a855f7; animation-delay: .22s; }
    .chat-typing span:nth-child(3) { background: #22d3ee; animation-delay: .44s; }

    @@keyframes typing-dot {
        0%, 60%, 100% { transform: translateY(0);   opacity: .4; }
        30%            { transform: translateY(-8px); opacity: 1;  }
    }

    .chat-loading-phase { font-family: 'Inter', sans-serif; font-size: .74rem; color: var(--text-dim); }

    /* ── Error bubble ── */
    .chat-error-bubble {
        background: rgba(220,38,38,.1);
        border: 1px solid rgba(220,38,38,.28);
        border-radius: 4px 16px 16px 16px;
        padding: .7rem 1rem;
        flex: 1;
        font-family: 'Inter', sans-serif; font-size: .85rem; color: #fca5a5;
    }

    /* ══════════════════════════════════════════
       PASEK KONTROLNY — JEDEN RZĄD
    ══════════════════════════════════════════ */
    .chat-input-bar {
        display: flex;
        align-items: center;
        gap: .55rem;
        padding: .8rem 1.1rem;
        background: var(--color-bar-bg);
        border-top: 1px solid var(--border);
        flex-wrap: nowrap;           /* desktop: jeden rząd */
        min-height: 56px;
    }

    .input-spacer { flex: 1; min-width: .25rem; }

    /* Dropdown szablonu */
    .ctrl-select {
        background: var(--color-input-bg);
        color: var(--text);
        border: 1px solid var(--color-input-border);
        border-radius: 7px;
        padding: .4rem .65rem;
        font-family: 'Inter', sans-serif;
        font-size: .8rem;
        outline: none;
        cursor: pointer;
        transition: border-color .2s;
        max-width: 140px;
        flex-shrink: 0;
    }

    .ctrl-select:focus { border-color: var(--primary-light); }
    .ctrl-select:disabled { opacity: .5; }

    /* Przycisk pliku */
    .file-pick {
        display: flex;
        align-items: center;
        gap: .4rem;
        background: var(--color-input-bg);
        color: var(--text-muted);
        border: 1px solid var(--color-input-border);
        border-radius: 7px;
        padding: .4rem .75rem;
        font-family: 'Inter', sans-serif;
        font-size: .8rem;
        cursor: pointer;
        transition: border-color .2s, color .2s;
        max-width: 180px;
        flex-shrink: 1;
    }

    .file-label-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
    }

    .file-pick:hover:not(.disabled) { border-color: var(--primary-light); color: var(--text); }
    .file-pick.disabled { opacity: .4; cursor: not-allowed; }

    /* Przyciski akcji */
    .ctrl-btn {
        display: flex;
        align-items: center;
        gap: .35rem;
        font-family: 'Inter', sans-serif;
        font-size: .8rem;
        font-weight: 500;
        border-radius: 7px;
        padding: .42rem .8rem;
        cursor: pointer;
        border: 1px solid transparent;
        transition: all .2s;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .ctrl-btn:disabled { opacity: .38; cursor: not-allowed; }

    .ctrl-btn-primary {
        background: linear-gradient(135deg, #7c3aed, #5b21b6);
        color: #fff;
        box-shadow: 0 0 14px rgba(124,58,237,.4);
    }
    .ctrl-btn-primary:hover:not(:disabled) { box-shadow: 0 0 24px rgba(124,58,237,.65); transform: translateY(-1px); }

    .ctrl-btn-secondary {
        background: transparent;
        color: var(--text-muted);
        border-color: var(--border);
    }
    .ctrl-btn-secondary:hover:not(:disabled) { border-color: var(--primary-light); color: var(--text); }

    .ctrl-btn-ghost {
        background: transparent;
        color: #67e8f9;
        border-color: rgba(34,211,238,.35);
    }
    .ctrl-btn-ghost:hover:not(:disabled) { background: rgba(34,211,238,.08); box-shadow: 0 0 12px rgba(34,211,238,.25); }

    :global(html.light-mode) .ctrl-btn-ghost { color: #0891b2; border-color: rgba(8,145,178,.35); }
    :global(html.light-mode) .ctrl-btn-ghost:hover:not(:disabled) { background: rgba(8,145,178,.07); }

    .spin-icon { display: inline-flex; animation: spin-anim .9s linear infinite; }
    @@keyframes spin-anim { to { transform: rotate(360deg); } }

    /* ══════════════════════════════════════════
       MOBILE RESPONSYWNOŚĆ
    ══════════════════════════════════════════ */
    @@media (max-width: 640px) {
        .analyzer-wrapper { padding: .75rem .75rem 1rem; }

        .chat-messages { min-height: 300px; max-height: 50vh; padding: .9rem; }

        .chat-user-bubble { max-width: 85%; font-size: .82rem; }
        .chat-assistant-bubble { font-size: .82rem; }

        /* Na mobile — dwa rzędy: [select + file] i [przyciski] */
        .chat-input-bar {
            flex-wrap: wrap;
            padding: .7rem .9rem;
            gap: .45rem;
        }

        .ctrl-select { flex: 1; max-width: none; }
        .file-pick   { flex: 1; max-width: none; }
        .input-spacer { display: none; }

        /* Przyciski na pełną szerokość w drugim rzędzie */
        .ctrl-btn { flex: 1; justify-content: center; }
        .btn-label { display: inline; }

        /* Ukryj etykiety na bardzo małych ekranach */
        @@media (max-width: 380px) {
            .btn-label { display: none; }
            .ctrl-btn { flex: 0 0 auto; padding: .42rem .6rem; }
        }
    }
</style>
