@page "/analyzer"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Text
@using EmailAnalyzer.Application
@using EmailAnalyzer.Domain
@using Markdig
@using Microsoft.AspNetCore.Authorization
@inject IEmailParser EmailParser
@inject IGeminiService GeminiService
@inject IJSRuntime JSRuntime
@inject AnalysisCounterService CounterService

<div class="terminal">
    <div class="terminal-output" id="terminal-output">
        @ConvertMarkdownToHtml(outputText)
        @if (!IsLoading)
        {
            <span class="cursor" style="opacity: @cursorOpacity;">_</span>
        }
    </div>
    <select @bind="selectedTemplateName">
        @foreach (var template in GeminiService.DefaultTemplates)
        {
            <option value="@template.Name">@template.Name</option>
        }
    </select>
    <button @onclick="Analyze" disabled="@IsLoading">Analizuj</button>
    <InputFile OnChange="HandleFileSelected" disabled="@IsLoading" accept=".eml" />
    @if (!string.IsNullOrEmpty(loadedFileName))
    {
        <span style="color: #28a745; font-family: 'Courier New', monospace; font-size: 0.85rem; margin-left: 8px;">
            ✓ @loadedFileName
        </span>
    }
    <button @onclick="ClearConsole" disabled="@IsLoading">Wyczyść</button>
    @if (analysisCompleted)
    {
        <button @onclick="CopyReportToClipboard">[ KOPIUJ RAPORT ]</button>
    }
</div>

@code {
    private static readonly MarkdownPipeline MarkdownPipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    private string outputText = "> Wgraj plik .eml...";
    private double cursorOpacity = 1;
    private System.Threading.Timer? cursorTimer;
    private string selectedTemplateName = string.Empty;
    private bool IsLoading = false;
    private bool analysisCompleted = false;
    private AnalysisResult? analysisResult;
    private char[] spinner = { '|', '/', '-', '\\' };
    private int spinnerIndex = 0;
    private int progress = 0;
    private byte[] fileContent = Array.Empty<byte>();
    private string loadedFileName = string.Empty;

    private MarkupString ConvertMarkdownToHtml(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return new MarkupString("");
        return new MarkupString(Markdown.ToHtml(markdown, MarkdownPipeline));
    }

    protected override void OnInitialized()
    {
        cursorTimer = new Timer(BlinkCursor, null, 0, 500);
        selectedTemplateName = GeminiService.DefaultTemplates.First().Name;
    }

    private void BlinkCursor(object? state)
    {
        if (!IsLoading)
        {
            cursorOpacity = cursorOpacity == 1 ? 0 : 1;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task CopyReportToClipboard()
    {
        if (analysisResult is not null)
            await JSRuntime.InvokeVoidAsync("copyToClipboard", analysisResult.AiAnalysis);
    }

    private async Task ScrollToBottom()
    {
        await JSRuntime.InvokeVoidAsync("scrollToBottom");
    }

    private async Task ClearConsole()
    {
        outputText = ">";
        fileContent = Array.Empty<byte>();
        loadedFileName = string.Empty;
        analysisCompleted = false;
        StateHasChanged();
        await ScrollToBottom();
    }

    private async Task Analyze()
    {
        if (fileContent.Length == 0)
        {
            outputText = "> Proszę wgrać plik .eml.";
            return;
        }

        IsLoading = true;
        analysisCompleted = false;
        analysisResult = null;
        outputText = string.Empty;
        progress = 0;

        try
        {
            EmailRecord? emailRecord = null;
            string? aiAnalysis = null;

            var analysisTask = Task.Run(async () =>
            {
                using var stream = new MemoryStream(fileContent);
                emailRecord = EmailParser.Parse(stream);

                var selectedTemplate = GeminiService.DefaultTemplates.First(t => t.Name == selectedTemplateName);
                aiAnalysis = await GeminiService.AnalyzeHeaders(emailRecord.RawHeaders, selectedTemplate);
            });

            while (!analysisTask.IsCompleted)
            {
                spinnerIndex = (spinnerIndex + 1) % spinner.Length;
                progress = Math.Min(progress + 5, 99);
                var progressBar = "[" + new string('#', progress / 10) + new string('.', 10 - progress / 10) + "]";
                outputText = $"> Analizowanie... {spinner[spinnerIndex]} {progressBar} {progress}%";
                StateHasChanged();
                await ScrollToBottom();
                await Task.Delay(200);
            }

            await analysisTask; // propaguje wyjątek jeśli był

            IsLoading = false;
            progress = 100;
            outputText = $"> Analizowanie... [##########] 100%<br/>";
            StateHasChanged();
            await ScrollToBottom();

            analysisResult = new AnalysisResult
            {
                FileName = loadedFileName,
                AnalysisDate = DateTime.Now,
                From = emailRecord!.From,
                Subject = emailRecord.Subject,
                AiAnalysis = aiAnalysis!
            };

            await AnimateText("> OTRZYMANO ODPOWIEDŹ OD AI...");
            outputText += analysisResult.AiAnalysis;
            analysisCompleted = true;
            CounterService.Increment();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            outputText += $"<br/><span style='color: red'>> !! SYSTEM ERROR: KERNEL PANIC !!</span><br/>";
            outputText += $"<span style='color: red'>> REASON: {ex.Message}</span><br/>";
            outputText += "<span style='color: red'>> Proszę sprawdzić klucz API w pliku konfiguracyjnym.</span><br/>";
            StateHasChanged();
            await ScrollToBottom();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task AnimateText(string text)
    {
        foreach (char c in text)
        {
            outputText += c;
            StateHasChanged();
            await ScrollToBottom();
            await Task.Delay(10);
        }
        outputText += "<br/>";
        StateHasChanged();
        await ScrollToBottom();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 10 * 1024 * 1024)
        {
            outputText = "> Błąd: Plik jest za duży (max 10 MB).";
            return;
        }

        using var memoryStream = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
        fileContent = memoryStream.ToArray();
        loadedFileName = file.Name;
    }

    public void Dispose()
    {
        cursorTimer?.Dispose();
    }
}

<style>
    .terminal {
        background-color: black;
        color: #e0d0ff;
        font-family: 'Courier New', Courier, monospace;
        padding: 20px;
        border-radius: 5px;
        height: 500px;
        overflow-y: auto;
    }

    .terminal-output {
        white-space: pre-wrap;
        color: #e0b0ff !important;
    }

    .terminal-output p, .terminal-output li, .terminal-output pre {
        color: #e0b0ff !important;
    }

    .terminal-output table {
        width: 100%;
        border-collapse: collapse;
        margin: 10px 0;
        color: #e0b0ff;
    }

    .terminal-output th, .terminal-output td {
        border: 1px solid #6f42c1;
        padding: 8px;
        text-align: left;
    }

    .terminal-output th {
        background-color: rgba(111, 66, 193, 0.3);
    }

    .terminal-output h1, .terminal-output h2 {
        color: #b19cd9;
        border-bottom: 1px solid #6f42c1;
    }

    .terminal textarea, .terminal select, .terminal button {
        background-color: #6f42c1;
        color: white;
        font-family: 'Courier New', Courier, monospace;
        border: 1px solid #6f42c1;
        margin: 5px;
        box-shadow: 0 0 5px #6f42c1, 0 0 10px #6f42c1, 0 0 15px #6f42c1;
    }

    .terminal textarea {
        width: 100%;
        resize: none;
    }

    .cursor {
        animation: blink 1s step-end infinite;
    }

    @@keyframes blink {
        from, to { color: transparent; }
        50% { color: #e0d0ff; }
    }
</style>
