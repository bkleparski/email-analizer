@page "/login"

<PageTitle>Logowanie — EBARTNET Security</PageTitle>

<div class="login-wrapper">

    <div class="login-nebula-accent"></div>

    <div class="glass-card login-box">

        <div class="login-brand">
            <div class="login-logo">⬡</div>
            <div class="login-title gradient-text">EBARTNET</div>
            <div class="login-subtitle">Email Security Analyzer</div>
        </div>

        @if (ShowError)
        {
            <div class="login-error">
                <span>⚠</span> Nieprawidłowy login lub hasło.
            </div>
        }

        <form method="post" action="/account/login">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="login-field">
                <label class="login-label">LOGIN</label>
                <input class="cosmic-input" type="text" name="username"
                       autocomplete="username" autofocus required />
            </div>

            <div class="login-field">
                <label class="login-label">HASŁO</label>
                <input class="cosmic-input" type="password" name="password"
                       autocomplete="current-password" required />
            </div>

            <button type="submit" class="btn-cosmic login-btn">
                Zaloguj się &nbsp; →
            </button>
        </form>

        <div class="login-hint">Dostęp tylko dla autoryzowanych użytkowników</div>
    </div>
</div>

<style>
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1rem;
        position: relative;
    }

    .login-nebula-accent {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 600px;
        height: 600px;
        background: radial-gradient(ellipse, rgba(124, 58, 237, 0.12) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    .login-box {
        width: 100%;
        max-width: 400px;
        padding: 2.5rem 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
        position: relative;
        z-index: 1;
    }

    .login-brand {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
    }

    .login-logo {
        font-size: 2.4rem;
        background: linear-gradient(135deg, #7c3aed, #06d6fa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 0 16px rgba(124, 58, 237, 0.7));
        line-height: 1;
    }

    .login-title {
        font-family: 'Inter', sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: 0.18em;
    }

    .login-subtitle {
        font-family: 'Inter', sans-serif;
        font-size: 0.75rem;
        color: #94a3b8;
        letter-spacing: 0.06em;
    }

    .login-error {
        background: rgba(244, 63, 94, 0.12);
        border: 1px solid rgba(244, 63, 94, 0.4);
        border-radius: 6px;
        padding: 0.65rem 1rem;
        color: #f87171;
        font-family: 'Inter', sans-serif;
        font-size: 0.82rem;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .login-field {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .login-label {
        font-family: 'Inter', sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        color: #94a3b8;
    }

    .login-btn {
        width: 100%;
        padding: 0.75rem;
        font-size: 0.88rem;
        margin-top: 0.3rem;
        border-radius: 8px;
    }

    .login-hint {
        font-family: 'Inter', sans-serif;
        font-size: 0.68rem;
        color: #64748b;
        text-align: center;
        letter-spacing: 0.04em;
    }
</style>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private bool ShowError => Error == "1";
}
