@page "/"
@attribute [Authorize]
@using EmailAnalyzer.Application
@using Microsoft.AspNetCore.Authorization
@inject AnalysisCounterService CounterService
@implements IDisposable

<PageTitle>Dashboard — EBARTNET Security</PageTitle>

<div class="dash-wrapper">

    <div class="dash-hero">
        <div class="dash-logo">⬡</div>
        <h1 class="dash-title gradient-text">EBARTNET SECURITY</h1>
        <p class="dash-subtitle">Email Intelligence & Threat Analysis Platform</p>
    </div>

    <div class="dash-cards">

        <div class="glass-card dash-card">
            <div class="dash-card-icon" style="color: #10b981;">◉</div>
            <div class="dash-card-label">STATUS SYSTEMU</div>
            <div class="dash-card-value" style="color: #10b981;">
                Online <span class="online-indicator"></span>
            </div>
        </div>

        <div class="glass-card dash-card">
            <div class="dash-card-icon" style="color: #06d6fa;">⬡</div>
            <div class="dash-card-label">MODEL AI</div>
            <div class="dash-card-value gradient-text">Gemini 2.5 Flash</div>
        </div>

        <div class="glass-card dash-card">
            <div class="dash-card-icon" style="color: #a855f7;">◈</div>
            <div class="dash-card-label">PRZEANALIZOWANO</div>
            <div class="dash-card-value stat-value">@CounterService.TotalAnalyses</div>
        </div>

    </div>

    <div class="dash-action">
        <a href="/analyzer" class="btn-launch">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <polyline points="9 12 11 14 15 10"/>
            </svg>
            <span>Uruchom Analizator</span>
        </a>
    </div>

    <div class="dash-footer">
        email-analizer.ebartnet.pl &nbsp;·&nbsp; Powered by Gemini AI
    </div>

</div>

<style>
    .dash-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 2rem 1rem;
        gap: 2.5rem;
    }

    .dash-hero {
        text-align: center;
    }

    .dash-logo {
        font-size: 3rem;
        background: linear-gradient(135deg, #7c3aed, #06d6fa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.5rem;
        filter: drop-shadow(0 0 20px rgba(124, 58, 237, 0.6));
    }

    .dash-title {
        font-family: 'Inter', sans-serif;
        font-size: clamp(1.6rem, 5vw, 2.8rem);
        font-weight: 700;
        letter-spacing: 0.12em;
        margin: 0 0 0.5rem;
        /* fallback jeśli gradient-text nie zadziała */
        color: #d8b4fe;
    }

    .dash-subtitle {
        font-family: 'Inter', sans-serif;
        color: #cbd5e1;
        font-size: 0.9rem;
        letter-spacing: 0.05em;
        margin: 0;
    }

    .dash-cards {
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .dash-card {
        padding: 1.6rem 2rem;
        min-width: 200px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    .dash-card-icon {
        font-size: 1.6rem;
        line-height: 1;
    }

    .dash-card-label {
        font-family: 'Inter', sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        color: #94a3b8;
        text-transform: uppercase;
    }

    .dash-card-value {
        font-family: 'Inter', sans-serif;
        font-size: 1.1rem;
        font-weight: 600;
        color: #f1f5f9;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient(135deg, #a855f7, #f472b6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.5));
    }

    .dash-action {
        margin-top: 0.5rem;
    }

    .btn-launch {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        background: linear-gradient(135deg,
            rgba(124, 58, 237, 0.18) 0%,
            rgba(6, 182, 212, 0.1) 100%);
        color: #67e8f9;
        border: 1px solid rgba(34, 211, 238, 0.45);
        border-radius: 14px;
        padding: 0.95rem 2.4rem;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.04em;
        text-decoration: none;
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
    }

    .btn-launch::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg,
            rgba(124, 58, 237, 0.14),
            rgba(6, 182, 212, 0.08));
        opacity: 0;
        transition: opacity 0.25s;
        border-radius: inherit;
    }

    .btn-launch:hover {
        border-color: rgba(34, 211, 238, 0.85);
        color: #fff;
        text-decoration: none;
        box-shadow: 0 0 28px rgba(34, 211, 238, 0.25),
                    0 0 55px rgba(124, 58, 237, 0.15);
        transform: translateY(-2px);
    }

    .btn-launch:hover::before { opacity: 1; }

    .btn-launch svg, .btn-launch span {
        position: relative;
        z-index: 1;
    }

    .dash-footer {
        font-family: 'Inter', sans-serif;
        font-size: 0.72rem;
        color: #64748b;
        letter-spacing: 0.06em;
        margin-top: 1rem;
    }

    @@media (max-width: 600px) {
        .dash-cards { flex-direction: column; align-items: center; }
        .dash-card { min-width: 280px; }
    }
</style>

@code {
    protected override void OnInitialized()
    {
        CounterService.OnChanged += OnCounterChanged;
    }

    private void OnCounterChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CounterService.OnChanged -= OnCounterChanged;
    }
}
