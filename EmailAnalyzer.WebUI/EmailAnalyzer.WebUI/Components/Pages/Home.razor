@page "/"
@attribute [Authorize]
@using EmailAnalyzer.Application
@using Microsoft.AspNetCore.Authorization
@inject AnalysisCounterService CounterService
@implements IDisposable

<style>
    .terminal-theme {
        background-color: #1a0c2e;
        color: #e0d0ff;
        font-family: 'Courier New', Courier, monospace;
    }

    .border-purple {
        border: 1px solid #6f42c1;
    }

    .online-indicator {
        height: 10px;
        width: 10px;
        background-color: #28a745;
        border-radius: 50%;
        display: inline-block;
    }
</style>

<div class="container-fluid terminal-theme vh-100 d-flex flex-column justify-content-center align-items-center">
    <div class="text-center">
        <h1 class="display-4 mb-5">WITAJ W SYSTEMIE ANALIZY EBARTNET</h1>
    </div>

    <div class="row mb-5">
        <div class="col-md-4">
            <div class="card bg-dark border-purple text-white">
                <div class="card-body">
                    <h5 class="card-title">STATUS SYSTEMU</h5>
                    <p class="card-text">Online <span class="online-indicator"></span></p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-purple text-white">
                <div class="card-body">
                    <h5 class="card-title">MODEL AI</h5>
                    <p class="card-text">Gemini 2.5 Flash (aktywny)</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-purple text-white">
                <div class="card-body">
                    <h5 class="card-title">STATYSTYKI</h5>
                    <p class="card-text">Przeanalizowano: @CounterService.TotalAnalyses</p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <a href="/analyzer" class="btn btn-outline-primary btn-lg p-5">URUCHOM TERMINAL ANALITYCZNY</a>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        CounterService.OnChanged += OnCounterChanged;
    }

    private void OnCounterChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CounterService.OnChanged -= OnCounterChanged;
    }
}
